# Copy to .env for local dev (docker-compose and `uv run` both read it).

# false (default) = query BigQuery for real, using Application Default
# Credentials (`gcloud auth application-default login`) or
# GOOGLE_APPLICATION_CREDENTIALS. This is the normal mode.
# true = serve generated fake data instead - only for offline dev/demo
# when you don't have BigQuery access at hand yet.
USE_MOCK_DATA=false

GCP_PROJECT_ID=langx-production
BQ_REPORTS_DATASET=dbt_reports
BQ_RAW_DATASET=dqa_pipeline

# How long a query result is reused before hitting BigQuery again. dbt refreshes
# hourly, so there is no point going back sooner than that.
CACHE_TTL_SECONDS=300

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173
